@model ErrorViewModel
@using InnovestHolding.Infrastructure
@{
    ViewData["Title"] = UserMessages.ErrorTitle;
}

<h1 class="text-danger">@UserMessages.ErrorTitle</h1>
<p>@UserMessages.ErrorGeneric</p>

@if (Model.ShowRequestId)
{
    <p>@UserMessages.ErrorReference: <code>@Model.RequestId</code></p>
}

<p><a href="/">@UserMessages.BackToHome</a></p>
