<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] - لوحة التحكم | Innovest</title>
    <link rel="icon" href="~/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body class="admin-body">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="sidebar-brand">
            <img src="~/assets/brand/logo-on-dark.png" asp-append-version="true" alt="Innovest Holding" class="sidebar-logo">
            <span class="sidebar-title">لوحة التحكم</span>
        </div>
        <nav class="sidebar-nav">
            @foreach (var (title, links) in groups)
            {
                var open = links.Any(l => string.Equals(l.Controller, current, StringComparison.OrdinalIgnoreCase));
                <details class="sidebar-group" open="@(open || title == groups[0].Title || title == groups[1].Title)" data-group="@title">
                    <summary class="sidebar-group-title">@title</summary>
                    @foreach (var link in links)
                    {
                        var href = "/Admin/" + link.Controller + (link.Action.Length > 0 ? "/" + link.Action : "");
                        var active = string.Equals(link.Controller, current, StringComparison.OrdinalIgnoreCase);
                        <a href="@href" class="sidebar-link@(active ? " active" : "")" aria-current="@(active ? "page" : null)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">@Html.Raw(link.Icon)</svg>
                            @link.Label
                            @if (badges.GetValueOrDefault(link.Controller) is > 0 and var count)
                            {
                                <span class="sidebar-badge">@count</span>
                            }
                        </a>
                    }
                </details>
            }
        </nav>
        <div class="sidebar-footer">
            <a href="/" target="_blank" rel="noopener" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                عرض الموقع
            </a>
            <a href="/en" target="_blank" rel="noopener" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                عرض النسخة الإنجليزية
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
        <!-- Top Header -->
        <header class="admin-header">
            <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="القائمة">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <h1 class="admin-page-title">@ViewData["Title"]</h1>
            <div class="admin-header-actions">
                <span class="admin-username">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    @User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                    <button type="submit" class="admin-logout-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        خروج
                    </button>
                </form>
            </div>
        </header>

        <!-- Content Area -->
        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    @TempData["Error"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <!-- Admin Sidebar Overlay for mobile -->
    <div class="admin-overlay" id="admin-overlay"></div>

    <script src="~/js/local-time.js" asp-append-version="true"></script>
    <script>
        (function() {
            const sidebar = document.getElementById('admin-sidebar');
            const overlay = document.getElementById('admin-overlay');
            const toggle = document.getElementById('sidebar-toggle');

            function toggleSidebar() {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
                document.body.style.overflow = sidebar.classList.contains('show') ? 'hidden' : '';
            }

            toggle?.addEventListener('click', toggleSidebar);
            overlay?.addEventListener('click', toggleSidebar);

            // Sidebar groups remember their open/closed state in this browser (a convenience: storage may be blocked).
            document.querySelectorAll('details.sidebar-group').forEach(group => {
                const key = 'admin-group:' + group.dataset.group;
                try {
                    const saved = localStorage.getItem(key);
                    if (saved !== null && !group.querySelector('.sidebar-link.active')) group.open = saved === '1';
                } catch (e) { /* storage unavailable */ }
                group.addEventListener('toggle', () => {
                    try { localStorage.setItem(key, group.open ? '1' : '0'); } catch (e) { /* storage unavailable */ }
                });
            });

            // Auto-hide alerts
            document.querySelectorAll('.alert').forEach(a => setTimeout(() => a.style.opacity = '0', 4000));
        })();
    </script>
</body>
</html>
