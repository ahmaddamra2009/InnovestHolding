@model PartnerVm
@* A partner: its logo (alt = the admin's alt text in the page language, else its name: SiteViews.Image) or its name; a link to its site when the admin set one (sponsor links are
   marked rel="sponsored", SEO decision). *@
@{
    var name = Model.Name;
}
@if (Model.Url is not null)
{
  <a href="@Model.Url" rel="sponsored noopener" target="_blank">
    @if (Model.Logo is { } logo)
    {
      <img src="@logo.Src" width="@logo.Width" height="@logo.Height" alt="@logo.Alt" lang="@logo.Alt.Lang" loading="lazy" decoding="async">
    }
    else
    {
      <span lang="@name.Lang" dir="@name.Dir">@name</span>
    }
  </a>
}
else if (Model.Logo is { } logo)
{
  <img src="@logo.Src" width="@logo.Width" height="@logo.Height" alt="@logo.Alt" lang="@logo.Alt.Lang" loading="lazy" decoding="async">
}
else
{
  <span lang="@name.Lang" dir="@name.Dir">@name</span>
}
