@model ContactFormVm
@{
    var p = Model.IdPrefix;
    var websiteHost = Uri.TryCreate(Model.Website, UriKind.Absolute, out var site) ? site.Host : Model.Website;
}
<div class="contact-grid">
  <div class="contact-info reveal-start">
    @if (!Model.Intro.IsEmpty)
    {
      <p class="contact-info-text" lang="@Model.Intro.Lang" dir="@Model.Intro.Dir">@Model.Intro</p>
    }
    <div class="contact-details">
      @if (!Model.Address.IsEmpty)
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactAddress]</h3><p lang="@Model.Address.Lang" dir="@Model.Address.Dir">@Model.Address</p></div>
        </div>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Phone))
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactPhone]</h3><p><bdi dir="ltr">@Model.Phone</bdi></p></div>
        </div>
      }
      @if (!string.IsNullOrWhiteSpace(Model.WhatsApp))
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 21l2.2-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactWhatsApp]</h3><p><a href="https://wa.me/@Model.WhatsApp" target="_blank" rel="noopener"><bdi dir="ltr">+@Model.WhatsApp</bdi></a></p></div>
        </div>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Email))
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactEmail]</h3><p><a href="mailto:@Model.Email"><bdi dir="ltr">@Model.Email</bdi></a></p></div>
        </div>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Website))
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactWebsite]</h3><p><a href="@Model.Website" target="_blank" rel="noopener"><bdi dir="ltr">@websiteHost</bdi></a></p></div>
        </div>
      }
      @if (!Model.Hours.IsEmpty)
      {
        <div class="contact-detail-item">
          <div class="contact-detail-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          <div class="contact-detail-text"><h3>@L[K.Ui.ContactHours]</h3><p lang="@Model.Hours.Lang" dir="@Model.Hours.Dir">@Model.Hours</p></div>
        </div>
      }
      @if (Model.Socials.Count > 0)
      {
        <div class="contact-social">
          <h3>@L[K.Ui.ContactSocial]</h3>
          <div class="social-links">
            @foreach (var social in Model.Socials)
            {
              if (InnovestHolding.Infrastructure.Site.SocialDisplay.Of(social) is not { } icon) { continue; }
              <a href="@social.Url" class="social-link" aria-label="@icon.Name" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(icon.Svg)</svg>
              </a>
            }
          </div>
        </div>
      }
    </div>
  </div>

  <div class="contact-form-wrap reveal-end">
    <form class="contact-form js-ajax-form" id="@(p)-form" method="post" action="@Model.Action" asp-antiforgery="true"
          data-msg-busy="@L[K.Ui.FormSending]" data-msg-error="@L[K.Ui.FormGenericError]" data-message-box="@(p)-msg">
      <div class="form-group">
        <label for="@(p)-name">@L[K.Ui.FormFullName]</label>
        <input type="text" id="@(p)-name" name="fullName" class="form-control" placeholder="@L[K.Ui.FormFullNamePlaceholderContact]" maxlength="200" required autocomplete="name">
      </div>
      <div class="form-group">
        <label for="@(p)-email">@L[K.Ui.FormEmail]</label>
        <input type="email" id="@(p)-email" name="email" class="form-control ltr-input" placeholder="@L[K.Ui.FormEmailPlaceholder]" maxlength="200" required dir="ltr" autocomplete="email">
      </div>
      <div class="form-group">
        <label for="@(p)-subject">@L[K.Ui.FormSubject]</label>
        <input type="text" id="@(p)-subject" name="subject" class="form-control" placeholder="@L[K.Ui.FormSubjectPlaceholder]" maxlength="300" required>
      </div>
      <div class="form-group">
        <label for="@(p)-message">@L[K.Ui.FormMessage]</label>
        <textarea id="@(p)-message" name="message" class="form-control" placeholder="@L[K.Ui.FormMessagePlaceholder]" maxlength="4000" required rows="4"></textarea>
      </div>
      <input type="text" name="Website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div id="@(p)-msg" class="form-message" role="alert" hidden></div>
      <button type="submit" class="form-submit-btn">
        <span>@L[K.Ui.ContactSubmit]</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>
</div>
