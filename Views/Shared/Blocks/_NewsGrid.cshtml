@model NewsBlock
<div class="news-grid">
  @for (var i = 0; i < Model.News.Count; i++)
  {
    var n = Model.News[i];
    <article class="news-card reveal@(HomeViewModel.Delay(i % 6 + 1))">
      <div class="news-card-img-wrap">
        <div class="news-visual" aria-hidden="true"><span class="tri-mark tri-mark-lg"></span></div>
        @if (!n.Category.IsEmpty)
        {
          <span class="news-category-badge" lang="@n.Category.Lang" dir="@n.Category.Dir">@n.Category</span>
        }
      </div>
      <div class="news-card-body">
        <div class="news-date">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span lang="@n.Date.Lang" dir="@n.Date.Dir">@n.Date</span>
        </div>
        <h3 lang="@n.Title.Lang" dir="@n.Title.Dir">@n.Title</h3>
        <p lang="@n.Summary.Lang" dir="@n.Summary.Dir">@n.Summary</p>
        @if (n.LinkUrl is not null)
        {
          <a href="@n.LinkUrl" class="news-read-more" rel="noopener">
            <span lang="@Model.ReadMore.Lang" dir="@Model.ReadMore.Dir">@Model.ReadMore</span>
            <svg class="i-dir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        }
      </div>
    </article>
  }
</div>
@if (Model.Pager is not null)
{
  <partial name="Blocks/_Pager" model="Model.Pager" />
}
