@model LoginViewModel
@using InnovestHolding.Infrastructure.Content
@inject ISiteContentCache SiteCache
@{
    Layout = null;
    // The same brand settings as the public site (one cached snapshot, no query on a cache hit): site name (Arabic,
    // the admin language), the uploaded logo on dark, the icons and theme colour; the bundled files while none is set.
    var snapshot = await SiteCache.GetAsync(Context.RequestAborted);
    var siteName = new ContentVm(snapshot.Content, false).Text("site_name").Value;
    var logo = snapshot.Image(SiteImages.LogoOnDark);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>@(string.IsNullOrWhiteSpace(siteName) ? "تسجيل الدخول" : $"تسجيل الدخول - {siteName}")</title>
    @await Component.InvokeAsync("BrandHead")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                @if (logo is not null)
                {
                    <img src="@logo.Url" width="@logo.Width" height="@logo.Height" alt="@siteName">
                }
                else
                {
                    <img src="~/assets/brand/logo-on-dark.png" asp-append-version="true" alt="@siteName">
                }
                <h2>لوحة التحكم</h2>
                <p>سجّل دخولك لإدارة الموقع</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="login-error">@Model.ErrorMessage</div>
            }

            <form asp-action="Login" method="post" class="login-form" asp-antiforgery="true">
                <div class="form-group">
                    <label>اسم المستخدم</label>
                    <input type="text" name="Username" value="@Model.Username" placeholder="أدخل اسم المستخدم" maxlength="100" autocomplete="username" required autofocus>
                </div>
                <div class="form-group">
                    <label>كلمة المرور</label>
                    <input type="password" name="Password" placeholder="أدخل كلمة المرور" maxlength="128" autocomplete="current-password" required>
                </div>
                <button type="submit" class="login-btn">تسجيل الدخول</button>
            </form>
        </div>
    </div>
</body>
</html>
