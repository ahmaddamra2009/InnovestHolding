@model InnovestHolding.Controllers.Admin.LeadsIndexVm
@using InnovestHolding.Infrastructure.Leads
@using InnovestHolding.Controllers.Admin
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "الطلبات";
    var list = Model.List;
    string Url(string? type, string? status) =>
        "/Admin/Leads" + QueryString.Create(new[]
        {
            new KeyValuePair<string, string?>("type", type),
            new KeyValuePair<string, string?>("status", status),
        }.Where(p => p.Value is not null));
    var basePath = Url(Model.Type, Model.Status);
    var pagerBase = basePath + (basePath.Contains('?') ? "&" : "?");
}

<div class="stats-cards" style="margin-bottom:24px;">
    @foreach (var (key, label) in LeadInbox.Types)
    {
        var unread = Model.Unread.Of(key);
        <a class="stat-card-admin lead-type-card@(unread > 0 ? " has-unread" : "")" href="@Url(key, unread > 0 ? LeadsController.Unread : null)">
            <div class="stat-card-info"><h3>@unread</h3><p>@label — غير مقروء</p></div>
        </a>
    }
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">@(Model.Type is null ? "كل الطلبات" : LeadInbox.Label(Model.Type)) (@list.TotalCount)</span>
    </div>

    <form method="get" action="/Admin/Leads" class="inline-form lead-filter">
        <div class="form-group">
            <label for="lead-type">النوع</label>
            <select id="lead-type" name="type" class="form-control">
                <option value="">الكل</option>
                @foreach (var (key, label) in LeadInbox.Types)
                {
                    <option value="@key" selected="@(Model.Type == key)">@label</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="lead-status">الحالة</label>
            <select id="lead-status" name="status" class="form-control">
                <option value="">الكل</option>
                <option value="@LeadsController.Unread" selected="@(Model.Status == LeadsController.Unread)">غير مقروء</option>
                <option value="@LeadsController.Read" selected="@(Model.Status == LeadsController.Read)">مقروء</option>
            </select>
        </div>
        <button type="submit" class="btn-admin btn-primary">عرض</button>
    </form>

    @if (list.TotalCount == 0)
    {
        <p style="text-align:center;color:var(--admin-text-muted);padding:40px 0;">لا توجد طلبات بهذا الاختيار</p>
    }
    else
    {
        <div class="table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>الحالة</th>
                    <th>النوع</th>
                    <th>الاسم</th>
                    <th>البريد الإلكتروني</th>
                    <th>التفاصيل</th>
                    <th>اللغة</th>
                    <th>التاريخ</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in list.Items)
            {
                <tr class="@(item.IsRead ? null : "is-unread")">
                    <td>
                        @if (!item.IsRead)
                        {
                            <span class="badge-new">جديد</span>
                        }
                        else
                        {
                            <span class="badge-active">مقروء</span>
                        }
                    </td>
                    <td>@LeadInbox.Label(item.Type)</td>
                    <td><a href="/Admin/Leads/Details/@item.Id@QueryString.Create(new[] { new KeyValuePair<string, string?>("type", item.Type), new KeyValuePair<string, string?>("status", Model.Status), new KeyValuePair<string, string?>("page", list.Page > 1 ? list.Page.ToString(System.Globalization.CultureInfo.InvariantCulture) : null) }.Where(p => p.Value is not null))"><strong>@item.Name</strong></a></td>
                    <td class="cell-ltr">@item.Email</td>
                    <td>@item.Summary</td>
                    <td>@(item.Culture == "en" ? "English" : "العربية")</td>
                    <td style="font-size:0.82rem;color:var(--admin-text-muted);">@TimeDisplay.Utc(item.CreatedAt)</td>
                    <td class="actions">
                        <form method="post" asp-action="ToggleRead" asp-controller="Leads" style="display:inline;">
                            <input type="hidden" name="type" value="@item.Type">
                            <input type="hidden" name="id" value="@item.Id">
                            <input type="hidden" name="listType" value="@Model.Type">
                            <input type="hidden" name="status" value="@Model.Status">
                            <input type="hidden" name="page" value="@list.Page">
                            <button type="submit" class="btn-admin btn-sm @(item.IsRead ? "btn-secondary" : "btn-primary")">@(item.IsRead ? "غير مقروء" : "مقروء ✓")</button>
                        </form>
                        <form method="post" asp-action="Delete" asp-controller="Leads" style="display:inline;">
                            <input type="hidden" name="type" value="@item.Type">
                            <input type="hidden" name="id" value="@item.Id">
                            <input type="hidden" name="listType" value="@Model.Type">
                            <input type="hidden" name="status" value="@Model.Status">
                            <input type="hidden" name="page" value="@list.Page">
                            <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا الطلب نهائياً؟')">حذف</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        @if (list.TotalPages > 1)
        {
            <nav class="pager" aria-label="الصفحات">
                @if (list.HasPrevious)
                {
                    <a class="btn-admin btn-secondary btn-sm" href="@(pagerBase)page=@(list.Page - 1)">السابق</a>
                }
                <span class="pager-info">صفحة @list.Page من @list.TotalPages</span>
                @if (list.HasNext)
                {
                    <a class="btn-admin btn-secondary btn-sm" href="@(pagerBase)page=@(list.Page + 1)">التالي</a>
                }
            </nav>
        }
    }
</div>
