@model List<NavItem>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إدارة القائمة الرئيسية"; }

<!-- Add New Item -->
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">إضافة عنصر جديد</span></div>
    <form method="post" asp-action="Create" asp-controller="Nav" class="inline-form">
        <div class="form-group"><label>الاسم</label><input type="text" name="title" class="form-control" placeholder="اسم العنصر" required></div>
        <div class="form-group"><label>الرابط</label><input type="text" name="href" class="form-control" placeholder="#section" required></div>
        <button type="submit" class="btn-admin btn-primary">إضافة</button>
    </form>
</div>

<!-- Menu Items List -->
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">عناصر القائمة (@Model.Count)</span></div>
    <table class="admin-table">
        <thead><tr><th>الاسم</th><th>الرابط</th><th>عناصر فرعية</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Title</strong></td>
                <td style="direction:ltr;text-align:right;"><code>@item.Href</code></td>
                <td>@(item.HasDropdown ? $"{item.SubItems.Count} عناصر" : "—")</td>
                <td>@(item.IsActive ? Html.Raw("<span class='badge-active'>مفعّل</span>") : Html.Raw("<span class='badge-inactive'>معطّل</span>"))</td>
                <td class="actions">
                    <form method="post" asp-action="Update" asp-controller="Nav" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id">
                        <input type="hidden" name="title" value="@item.Title">
                        <input type="hidden" name="href" value="@item.Href">
                        <input type="hidden" name="hasDropdown" value="@item.HasDropdown">
                        <input type="hidden" name="isActive" value="@(!item.IsActive)">
                        <button type="submit" class="btn-admin btn-sm @(item.IsActive ? "btn-danger" : "btn-primary")">@(item.IsActive ? "تعطيل" : "تفعيل")</button>
                    </form>
                    <form method="post" asp-action="Delete" asp-controller="Nav" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id">
                        <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف العنصر وكل عناصره الفرعية؟')">حذف</button>
                    </form>
                </td>
            </tr>
            @if (item.HasDropdown || item.SubItems.Any())
            {
                <tr>
                    <td colspan="5" style="padding:0 16px 16px 16px;">
                        <div class="sub-items-list">
                            <strong style="font-size:0.82rem;color:var(--admin-text-muted);display:block;margin-bottom:8px;">العناصر الفرعية:</strong>
                            @foreach (var sub in item.SubItems)
                            {
                                <div class="sub-item-row">
                                    <span class="sub-item-title">@sub.Title</span>
                                    <code style="font-size:0.75rem;color:var(--admin-text-muted);">@sub.Href</code>
                                    <form method="post" asp-action="DeleteSubItem" asp-controller="Nav" style="display:inline;">
                                        <input type="hidden" name="id" value="@sub.Id">
                                        <button type="submit" class="btn-admin btn-danger btn-sm">×</button>
                                    </form>
                                </div>
                            }
                            <!-- Add Sub Item -->
                            <form method="post" asp-action="AddSubItem" asp-controller="Nav" class="inline-form" style="margin-top:8px;padding:12px;">
                                <input type="hidden" name="navItemId" value="@item.Id">
                                <div class="form-group"><label>اسم العنصر الفرعي</label><input type="text" name="title" class="form-control" placeholder="اسم العنصر" required></div>
                                <div class="form-group"><label>الرابط</label><input type="text" name="href" class="form-control" placeholder="#section" required></div>
                                <button type="submit" class="btn-admin btn-primary btn-sm">+ إضافة فرعي</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
