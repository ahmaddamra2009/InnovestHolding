@model NavAdminVm
@using InnovestHolding.Infrastructure.Site
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "القائمة والفوتر";
    var footerTab = Model.Tab == NavAdminVm.FooterTab;
    int Depth(string key) => SiteRoutes.Chain(key).Count() - 1;
}
<nav class="group-tabs" aria-label="القائمة والفوتر">
    <a asp-action="Index" class="@(footerTab ? "" : "active")" aria-current="@(footerTab ? null : "page")">القائمة العلوية</a>
    <a asp-action="Index" asp-route-tab="@NavAdminVm.FooterTab" class="@(footerTab ? "active" : "")" aria-current="@(footerTab ? "page" : null)">أعمدة الفوتر</a>
</nav>

@if (!footerTab)
{
    <div class="admin-card">
        <div class="admin-card-header"><span class="admin-card-title">إضافة رابط إضافي</span></div>
        <p class="form-hint">روابط تظهر بعد صفحات الموقع في القائمة العلوية (إن كان «في القائمة» ظاهراً) وفي عمود «روابط سريعة» بالفوتر التلقائي. القوائم الفرعية غير مدعومة: استخدم صفحة ابنة من «صفحات الموقع».</p>
        <form method="post" asp-action="Create" asp-controller="Nav">
            <lang-pair label="الاسم" name-ar="TitleAr" name-en="TitleEn" max="100" required="true" id-prefix="new-" />
            <div class="inline-form">
                <div class="form-group"><label for="new-href">الرابط</label><input type="text" id="new-href" name="Href" class="form-control ltr-input" dir="ltr" placeholder="https://" maxlength="255" required></div>
                <button type="submit" class="btn-admin btn-primary">إضافة</button>
            </div>
        </form>
    </div>

    <div class="admin-card">
        <div class="admin-card-header"><span class="admin-card-title">الروابط الإضافية (@Model.Items.Count)</span></div>
        @if (Model.Items.Count == 0)
        {
            <p class="form-hint">لا توجد روابط إضافية بعد.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table" style="min-width:640px;">
                    <thead><tr><th>#</th><th>الاسم</th><th>الرابط</th><th>EN</th><th>الحالة</th><th>في القائمة العلوية</th><th>الترتيب</th><th>إجراءات</th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr id="row-@item.Id" tabindex="-1" class="@(item.IsActive ? "" : "row-hidden")">
                            <td>@(i + 1)</td>
                            <td>
                                <strong>@item.TitleAr</strong>
                                <details class="row-editor">
                                    <summary>تعديل</summary>
                                    <form method="post" asp-action="Update" asp-controller="Nav" class="edit-form">
                                        <input type="hidden" name="Id" value="@item.Id">
                                        <lang-pair label="الاسم" name-ar="TitleAr" name-en="TitleEn" value-ar="@item.TitleAr" value-en="@item.TitleEn" max="100" required="true" id-prefix="nav@(item.Id)-" />
                                        <div class="inline-form">
                                            <div class="form-group"><label for="nav@(item.Id)-href">الرابط</label><input type="text" id="nav@(item.Id)-href" name="Href" value="@item.Href" class="form-control ltr-input" dir="ltr" maxlength="255" required></div>
                                            <button type="submit" class="btn-admin btn-primary btn-sm">حفظ</button>
                                        </div>
                                    </form>
                                </details>
                            </td>
                            <td class="cell-ltr"><code>@item.Href</code></td>
                            <td><partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="@(!string.IsNullOrWhiteSpace(item.TitleEn))" /></td>
                            <td><partial name="~/Views/Admin/Shared/_VisibleSwitch.cshtml" model="@(new VisibleSwitchVm("Nav", item.Id.ToString(), item.TitleAr, item.IsActive))" /></td>
                            <td><partial name="~/Views/Admin/Shared/_VisibleSwitch.cshtml" model="@(new VisibleSwitchVm("Nav", item.Id.ToString(), item.TitleAr, item.ShowInHeader, "ToggleHeader"))" /></td>
                            <td><partial name="~/Views/Admin/Shared/_ReorderCell.cshtml" model="@(new ReorderCellVm("Nav", item.Id.ToString(), item.TitleAr, i + 1, Model.Items.Count))" /></td>
                            <td class="actions">
                                <form method="post" asp-action="Delete" asp-controller="Nav" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id">
                                    <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا الرابط من القائمة والفوتر نهائياً؟ يمكنك بدلاً من ذلك إخفاءه.')">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="form-hint">«الحالة» = يظهر في الموقع (القائمة والفوتر). «في القائمة العلوية» = يظهر في رأس الموقع وقائمة الجوال فقط؛ الفوتر التلقائي يعرض كل رابط ظاهر، ومكانه في الفوتر المخصّص يُحدَّد في «أعمدة الفوتر».</p>
        }
    </div>
}
else if (!Model.IsCustomised)
{
    <div class="admin-card">
        <div class="admin-card-header"><span class="admin-card-title">أعمدة الفوتر</span></div>
        <p class="form-hint">الأعمدة تُبنى الآن تلقائياً من صفحات الموقع («يظهر في الفوتر» في «صفحات الموقع») والروابط الإضافية. اضغط «تخصيص الأعمدة» لنسخ الفوتر الحالي كما هو ثم تعديل العناوين والروابط وترتيبها (حتى @($"{FooterBuilder.MaxColumns} أعمدة و{FooterBuilder.MaxLinks} روابط") في كل عمود).</p>
        @if (Model.AutomaticPlan is { } plan)
        {
            <div class="table-scroll">
                <table class="admin-table" style="min-width:520px;">
                    <thead><tr><th>العمود</th><th>الروابط الآن</th></tr></thead>
                    <tbody>
                    @foreach (var col in plan)
                    {
                        <tr>
                            <td><strong>@(col.TitlePageKey is { } k ? Model.PageTitle(k) : Model.QuickLinksTitle)</strong></td>
                            <td>@string.Join(" · ", col.Links.Skip(col.TitlePageKey is null ? 0 : 1).Select(l => Model.Describe(l.PageKey, l.NavItemId).Label))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <form method="post" asp-action="CustomiseFooter" asp-controller="Nav" style="margin-top:12px;">
            <button type="submit" class="btn-admin btn-primary">تخصيص الأعمدة</button>
        </form>
    </div>
}
else
{
    <div class="admin-card">
        <div class="admin-card-header"><span class="admin-card-title">أعمدة الفوتر (مخصّصة: @Model.Columns.Count من @FooterBuilder.MaxColumns)</span></div>
        <p class="form-hint">العمود الذي أول رابط فيه يحمل اسم العمود نفسه يظهر عنوانه رابطاً (كأعمدة الوحدات). الرابط إلى صفحة غير منشورة أو رابط إضافي مخفي لا يظهر، والعمود بلا روابط ظاهرة لا يظهر.</p>
        <div class="inline-actions">
            @if (Model.Columns.Count < FooterBuilder.MaxColumns)
            {
                <details class="row-editor">
                    <summary>+ إضافة عمود</summary>
                    <form method="post" asp-action="AddColumn" asp-controller="Nav" class="edit-form">
                        <lang-pair label="عنوان العمود" name-ar="TitleAr" name-en="TitleEn" max="100" required="true" id-prefix="col-new-" />
                        <button type="submit" class="btn-admin btn-primary btn-sm">إضافة</button>
                    </form>
                </details>
            }
            <form method="post" asp-action="ResetFooter" asp-controller="Nav">
                <button type="submit" class="btn-admin btn-secondary btn-sm" onclick="return confirm('حذف الأعمدة المخصّصة والعودة إلى الفوتر التلقائي؟')">إعادة إلى التلقائي</button>
            </form>
        </div>
    </div>

    @for (var c = 0; c < Model.Columns.Count; c++)
    {
        var col = Model.Columns[c];
        var links = col.Links.ToList();
        <div class="admin-card" id="col-@col.Id" tabindex="-1">
            <div class="admin-card-header">
                <span class="admin-card-title">العمود @(c + 1): @col.TitleAr</span>
                <partial name="~/Views/Admin/Shared/_ReorderCell.cshtml" model="@(new ReorderCellVm("Nav", col.Id.ToString(), col.TitleAr, c + 1, Model.Columns.Count, "MoveColumn"))" />
            </div>
            <form method="post" asp-action="UpdateColumn" asp-controller="Nav" class="edit-form">
                <input type="hidden" name="Id" value="@col.Id">
                <lang-pair label="عنوان العمود" name-ar="TitleAr" name-en="TitleEn" value-ar="@col.TitleAr" value-en="@col.TitleEn" max="100" required="true" id-prefix="col@(col.Id)-" />
                <button type="submit" class="btn-admin btn-primary btn-sm">حفظ العنوان</button>
            </form>
            <div class="table-scroll">
                <table class="admin-table" style="min-width:560px;">
                    <thead><tr><th>#</th><th>الرابط</th><th>المصدر</th><th>الحالة</th><th>الترتيب</th><th>إجراءات</th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < links.Count; i++)
                    {
                        var link = links[i];
                        var (label, kind, shown) = Model.Describe(link.PageKey, link.NavItemId);
                        <tr class="@(shown ? "" : "row-hidden")">
                            <td>@(i + 1)</td>
                            <td>@label</td>
                            <td>@kind</td>
                            <td>@if (shown) { <span class="badge-active">ظاهر</span> } else { <span class="badge-inactive">لا يظهر</span> }</td>
                            <td><partial name="~/Views/Admin/Shared/_ReorderCell.cshtml" model="@(new ReorderCellVm("Nav", link.Id.ToString(), label, i + 1, links.Count, "MoveLink"))" /></td>
                            <td>
                                <form method="post" asp-action="DeleteLink" asp-controller="Nav" style="display:inline;">
                                    <input type="hidden" name="id" value="@link.Id">
                                    <button type="submit" class="btn-admin btn-danger btn-sm">إزالة</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (links.Count < FooterBuilder.MaxLinks)
            {
                <form method="post" asp-action="AddLink" asp-controller="Nav" class="inline-form" style="margin-top:12px;">
                    <input type="hidden" name="ColumnId" value="@col.Id">
                    <div class="form-group">
                        <label for="col@(col.Id)-target">إضافة رابط</label>
                        <select id="col@(col.Id)-target" name="Target" class="form-control" required>
                            <option value="">— اختر —</option>
                            <optgroup label="صفحة">
                                @foreach (var route in SiteRoutes.All)
                                {
                                    <option value="@("page:" + route.Key)">@(new string('–', Depth(route.Key))) @Model.PageTitle(route.Key)</option>
                                }
                            </optgroup>
                            @if (Model.Items.Count > 0)
                            {
                                <optgroup label="رابط إضافي">
                                    @foreach (var nav in Model.Items)
                                    {
                                        <option value="nav:@nav.Id">@nav.TitleAr</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-admin btn-primary btn-sm">إضافة</button>
                </form>
            }
            <form method="post" asp-action="DeleteColumn" asp-controller="Nav" style="margin-top:12px;">
                <input type="hidden" name="id" value="@col.Id">
                <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا العمود وروابطه من الفوتر؟')">حذف العمود</button>
            </form>
        </div>
    }
}
