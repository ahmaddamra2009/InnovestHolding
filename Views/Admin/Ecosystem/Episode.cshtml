@model EpisodeInput
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var l = (AdminListLabels)ViewData["Labels"]!;
    ViewData["Title"] = (Model.Id > 0 ? "تعديل — " : "إضافة — ") + l.Title;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="admin-card">
    <form method="post" asp-controller="@l.Controller" asp-action="@(Model.Id > 0 ? "Edit" : "Create")" enctype="multipart/form-data">
        @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }
        <lang-pair label="عنوان الحلقة" name-ar="TitleAr" name-en="TitleEn" value-ar="@Model.TitleAr" value-en="@Model.TitleEn" max="200" required="true" />
        <lang-pair label="الملخص (البطاقة وأول فقرة في صفحة الحلقة)" name-ar="SummaryAr" name-en="SummaryEn" value-ar="@Model.SummaryAr" value-en="@Model.SummaryEn" max="500" rows="3" required="true" />
        <lang-pair label="وصف الحلقة (سطر فارغ = فقرة جديدة)" name-ar="BodyAr" name-en="BodyEn" value-ar="@Model.BodyAr" value-en="@Model.BodyEn" max="20000" rows="6" />
        <div style="display:flex;gap:16px;flex-wrap:wrap;">
            <div class="form-group" style="max-width:160px;"><label for="Season">الموسم (اختياري)</label><input id="Season" name="Season" type="number" min="1" max="999" class="form-control" value="@Model.Season?.ToString(inv)"><span asp-validation-for="Season" class="field-error"></span></div>
            <div class="form-group" style="max-width:160px;"><label for="Number">رقم الحلقة (اختياري)</label><input id="Number" name="Number" type="number" min="1" max="9999" class="form-control" value="@Model.Number?.ToString(inv)"><span asp-validation-for="Number" class="field-error"></span></div>
            <div class="form-group" style="max-width:220px;"><label for="AiredOn">تاريخ العرض (اختياري)</label><input id="AiredOn" name="AiredOn" type="date" class="form-control" value="@Model.AiredOn?.ToString("yyyy-MM-dd", inv)"><span asp-validation-for="AiredOn" class="field-error"></span></div>
        </div>
        <lang-pair label="رابط الفيديو (https — رابط يوتيوب يُعرض بمشغّل لا يتصل بيوتيوب إلا عند الضغط؛ أي رابط آخر يظهر زراً)" name-ar="VideoUrl" value-ar="@Model.VideoUrl" max="500" ltr="true" placeholder="https://www.youtube.com/watch?v=…" />
        <fieldset class="image-field">
            <legend>ضيوف الحلقة (بالترتيب المعروض)</legend>
            @if (Model.GuestChoices.Count == 0)
            {
                <p class="field-hint">لا يوجد ضيوف بعد — أضفهم من «ضيوف البرنامج» ثم اربطهم هنا.</p>
            }
            @foreach (var g in Model.GuestChoices)
            {
                <label class="form-check" style="display:block;"><input type="checkbox" name="GuestIds" value="@g.Id" @(Model.GuestIds.Contains(g.Id) ? "checked" : null)> @g.Label @if (!g.Active) { <span class="badge-inactive">مخفي</span> }</label>
            }
            <span asp-validation-for="GuestIds" class="field-error"></span>
        </fieldset>
        <partial name="~/Views/Admin/Ecosystem/_Common.cshtml" model="Model" view-data="ViewData" />
    </form>
</div>
