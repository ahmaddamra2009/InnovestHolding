@model List<Stat>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إدارة الإحصائيات"; }
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">الإحصائيات (@Model.Count)</span></div>
    @foreach (var item in Model)
    {
        var prefix = $"st{item.Id}-";
        <form method="post" asp-action="Update" asp-controller="Stats" class="row-form">
            <input type="hidden" name="id" value="@item.Id">
            <div class="row-form-head">
                <strong>@item.LabelAr</strong>
                <partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="@(!string.IsNullOrWhiteSpace(item.LabelEn))" />
            </div>
            <lang-pair label="التسمية" name-ar="LabelAr" name-en="LabelEn" value-ar="@item.LabelAr" value-en="@item.LabelEn" max="100" required="true" id-prefix="@prefix" />
            <lang-pair label="التسمية المختصرة في عدادات الواجهة (اختياري)" name-ar="ShortLabelAr" name-en="ShortLabelEn" value-ar="@item.ShortLabelAr" value-en="@item.ShortLabelEn" max="100" id-prefix="@prefix" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;">
                <div class="form-group"><label>القيمة</label><input type="number" name="value" class="form-control" value="@item.Value" min="0" max="1000000000" required></div>
                <div class="form-group"><label>اللاحقة</label><input type="text" name="suffix" class="form-control ltr-input" dir="ltr" value="@item.Suffix" maxlength="10"></div>
            </div>
            <button type="submit" class="btn-admin btn-primary btn-sm">حفظ</button>
        </form>
    }
</div>
