@model List<Partner>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إدارة الشركاء"; }
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">إضافة شريك جديد</span></div>
    <form method="post" asp-action="Create" asp-controller="Partners">
        <lang-pair label="اسم الشريك" name-ar="NameAr" name-en="NameEn" max="200" required="true" id-prefix="new-" />
        <button type="submit" class="btn-admin btn-primary">إضافة</button>
    </form>
</div>
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">الشركاء الحاليون (@Model.Count)</span></div>
    <table class="admin-table">
        <thead><tr><th>#</th><th>الاسم</th><th>EN</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SortOrder</td>
                <td>
                    <strong>@item.NameAr</strong>
                    <details class="row-editor">
                        <summary>تعديل</summary>
                        <form method="post" asp-action="Update" asp-controller="Partners" class="edit-form">
                            <input type="hidden" name="id" value="@item.Id">
                            <lang-pair label="اسم الشريك" name-ar="NameAr" name-en="NameEn" value-ar="@item.NameAr" value-en="@item.NameEn" max="200" required="true" id-prefix="p@(item.Id)-" />
                            <button type="submit" class="btn-admin btn-primary btn-sm">حفظ</button>
                        </form>
                    </details>
                </td>
                <td><partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="@(!string.IsNullOrWhiteSpace(item.NameEn))" /></td>
                <td><form method="post" asp-action="Delete" asp-controller="Partners" style="display:inline;"><input type="hidden" name="id" value="@item.Id"><button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا الشريك؟')">حذف</button></form></td>
            </tr>
        }
        </tbody>
    </table>
</div>
