@model Event
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إضافة فعالية جديدة"; }

<div class="admin-card">
    <form method="post" asp-action="Create" asp-controller="Events">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group" style="grid-column:span 2;"><label>عنوان الفعالية</label><input type="text" name="Title" class="form-control" required></div>
            <div class="form-group" style="grid-column:span 2;"><label>الوصف</label><textarea name="Description" class="form-control" rows="3"></textarea></div>
            <div class="form-group"><label>اليوم</label><input type="number" name="EventDay" class="form-control" min="1" max="31" required></div>
            <div class="form-group"><label>الشهر</label><input type="text" name="EventMonth" class="form-control" placeholder="مثال: يوليو" required></div>
            <div class="form-group"><label>المكان</label><input type="text" name="Location" class="form-control"></div>
            <div class="form-group"><label>الوقت</label><input type="text" name="Time" class="form-control" placeholder="مثال: 9:00 ص - 5:00 م"></div>
        </div>
        <div class="form-check" style="margin-bottom:20px;"><input type="checkbox" name="IsActive" value="true" checked> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ الفعالية</button>
        <a href="/Events" class="btn-admin btn-secondary" style="margin-right:12px;">إلغاء</a>
    </form>
</div>
