@model EventInput
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إضافة فعالية جديدة"; }

<div class="admin-card">
    <form method="post" asp-action="Create" asp-controller="Events">
        @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }
        <partial name="~/Views/Admin/Events/_Fields.cshtml" model="Model" />
        <div class="form-check" style="margin-bottom:20px;"><input asp-for="IsActive"> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ الفعالية</button>
        <a href="/Admin/Events" class="btn-admin btn-secondary" style="margin-inline-start:12px;">إلغاء</a>
    </form>
</div>
