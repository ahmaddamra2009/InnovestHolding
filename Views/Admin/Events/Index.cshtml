@model List<Event>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إدارة الفعاليات"; }

<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">الفعاليات (@Model.Count)</span>
        <a href="/Events/Create" class="btn-admin btn-primary btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            إضافة فعالية
        </a>
    </div>
    <table class="admin-table">
        <thead><tr><th>العنوان</th><th>التاريخ</th><th>المكان</th><th>EN</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            var en = !string.IsNullOrWhiteSpace(item.TitleEn) && !string.IsNullOrWhiteSpace(item.EventMonthEn)
                     && (string.IsNullOrWhiteSpace(item.DescriptionAr) || !string.IsNullOrWhiteSpace(item.DescriptionEn));
            <tr>
                <td><strong>@item.TitleAr</strong></td>
                <td>@item.EventDay @item.EventMonthAr</td>
                <td>@item.LocationAr</td>
                <td><partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="en" /></td>
                <td>@if (item.IsActive) { <span class="badge-active">مفعّل</span> } else { <span class="badge-inactive">معطّل</span> }</td>
                <td class="actions">
                    <a href="/Events/Edit/@item.Id" class="btn-admin btn-secondary btn-sm">تعديل</a>
                    <form method="post" asp-action="Delete" asp-controller="Events" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id">
                        <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('هل تريد حذف هذه الفعالية؟')">حذف</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
