@model Event
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "تعديل الفعالية"; }

<div class="admin-card">
    <form method="post" asp-action="Edit" asp-controller="Events">
        <input type="hidden" name="Id" value="@Model.Id">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group" style="grid-column:span 2;"><label>عنوان الفعالية</label><input type="text" name="Title" class="form-control" value="@Model.Title" required></div>
            <div class="form-group" style="grid-column:span 2;"><label>الوصف</label><textarea name="Description" class="form-control" rows="3">@Model.Description</textarea></div>
            <div class="form-group"><label>اليوم</label><input type="number" name="EventDay" class="form-control" value="@Model.EventDay" min="1" max="31" required></div>
            <div class="form-group"><label>الشهر</label><input type="text" name="EventMonth" class="form-control" value="@Model.EventMonth" required></div>
            <div class="form-group"><label>المكان</label><input type="text" name="Location" class="form-control" value="@Model.Location"></div>
            <div class="form-group"><label>الوقت</label><input type="text" name="Time" class="form-control" value="@Model.Time"></div>
            <div class="form-group"><label>الترتيب</label><input type="number" name="SortOrder" class="form-control" value="@Model.SortOrder"></div>
        </div>
        <div class="form-check" style="margin-bottom:20px;"><input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ التعديلات</button>
        <a href="/Events" class="btn-admin btn-secondary" style="margin-right:12px;">إلغاء</a>
    </form>
</div>
