@model ContentEditInput
@using InnovestHolding.Infrastructure.Content
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "تعديل المحتوى"; }

@if (ViewData[InnovestHolding.Controllers.Admin.ContentController.SiteImagesKey] is List<(SiteImage Image, SiteImageInput Input)> siteImages)
{
    @* One small form (multipart) per site image: logos, home hero image, founder photo. *@
    <details class="admin-card" open="@siteImages.Any(x => x.Input.Current is null)">
        <summary class="admin-card-title">صور الموقع (الشعار، صورة الواجهة، صورة المؤسس)</summary>
        @foreach (var (image, input) in siteImages)
        {
            <form method="post" asp-action="SiteImage" asp-controller="Content" enctype="multipart/form-data" class="row-editor" id="image-@image.Key">
                <input type="hidden" name="Key" value="@image.Key">
                <p class="field-hint">@image.Hint</p>
                @{ ViewData["ImageLabel"] = image.Label; ViewData["ImagePrefix"] = image.Key + "-"; ViewData["ImageUse"] = image.IsLogo ? "logo" : null; }
                <partial name="~/Views/Admin/Shared/_ImageField.cshtml" model="input" view-data="ViewData" />
                <button type="submit" class="btn-admin btn-primary">حفظ الصورة</button>
            </form>
        }
    </details>
}

<form method="post" asp-action="Edit" asp-controller="Content" class="content-editor">
    @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }

    @foreach (var (groupId, groupTitle) in ContentKeys.Groups)
    {
        var keys = ContentKeys.All.Where(k => k.Group == groupId).ToList();
        var translatable = keys.Where(k => !k.Neutral).ToList();
        var done = translatable.Count(k => !string.IsNullOrWhiteSpace(Model.Content.GetValueOrDefault(k.Key)?.En));
        <div class="admin-card" id="group-@groupId">
            <div class="admin-card-header">
                <span class="admin-card-title">@groupTitle</span>
                @if (translatable.Count > 0)
                {
                    <span class="@(done == translatable.Count ? "badge-active" : "badge-inactive") en-chip">EN @done/@translatable.Count</span>
                }
            </div>
            @foreach (var key in keys)
            {
                var value = Model.Content.GetValueOrDefault(key.Key) ?? new BilingualValueInput();
                var rows = key.Multiline ? 3 : 0;
                if (key.Rule == ContentRule.Link)
                {
                    @* A page picker (route table) with «رابط خارجي…»: the https address goes in the box beside it. *@
                    var choices = ViewData[InnovestHolding.Controllers.Admin.ContentController.PageChoicesKey] as IReadOnlyList<KeyValuePair<string, string>> ?? [];
                    var id = "content-" + key.Key.Replace('_', '-');
                    var current = value.Ar?.Trim() ?? "";
                    var isPage = choices.Any(c => c.Key == current);
                    var isExternal = !isPage && current.Length > 0 && ContentKeys.IsExternalLink(current);
                    var defaultTitle = key.Default is null ? null : choices.FirstOrDefault(c => c.Key == key.Default).Value;
                    <div class="form-group">
                        <label for="@id">@key.Label</label>
                        <select id="@id" name="content[@key.Key].Ar" class="form-control">
                            @if (key.AllowEmpty)
                            {
                                <option value="" selected="@(current.Length == 0)">@(key.Key switch { "hero_cta_main_link" => "نفس وجهة زر الهيدر (افتراضي)", "cta_band_button2_link" => "بلا زر ثانٍ", _ => "الافتراضي" })</option>
                            }
                            else if (!isPage && !isExternal)
                            {
                                <option value="@value.Ar" selected>@value.Ar</option>
                            }
                            @foreach (var choice in choices)
                            {
                                <option value="@choice.Key" selected="@(choice.Key == current)">@choice.Value</option>
                            }
                            <option value="@ContentKeys.ExternalLinkChoice" selected="@isExternal">رابط خارجي… (https)</option>
                        </select>
                        <input type="url" dir="ltr" class="form-control" name="@InnovestHolding.Controllers.Admin.ContentController.ExternalField(key.Key)"
                               value="@(isExternal ? current : null)" placeholder="https://" maxlength="@key.MaxLength" aria-label="@key.Label — رابط خارجي" />
                        <p class="form-hint">اختر «رابط خارجي…» واكتب العنوان في المربع ليُفتح موقع آخر (يلزمه نص بالعربية). الزر الذي يشير إلى صفحة غير منشورة لا يظهر.@(defaultTitle is null ? "" : $" الافتراضي: {defaultTitle}.")</p>
                    </div>
                }
                else if (key.Rule == ContentRule.IconKey)
                {
                    var id = "content-" + key.Key.Replace('_', '-');
                    var current = value.Ar?.Trim() ?? "";
                    var defaultIcon = key.Default is null ? null : Icons.All.GetValueOrDefault(key.Default).Label;
                    <div class="form-group">
                        <label for="@id">@key.Label</label>
                        <select id="@id" name="content[@key.Key].Ar" class="form-control">
                            @if (!Icons.IsKnown(current))
                            {
                                <option value="" selected>الافتراضي@(defaultIcon is null ? "" : $" ({defaultIcon})")</option>
                            }
                            @foreach (var (iconKey, icon) in Icons.All)
                            {
                                <option value="@iconKey" selected="@(iconKey == current)">@icon.Label (@iconKey)</option>
                            }
                        </select>
                    </div>
                }
                else if (key.Rule == ContentRule.PageKeyList)
                {
                    var choices = ViewData[InnovestHolding.Controllers.Admin.ContentController.PageChoicesKey] as IReadOnlyList<KeyValuePair<string, string>> ?? [];
                    var selected = ContentKeys.PageList(value.Ar).ToHashSet(StringComparer.Ordinal);
                    <fieldset class="form-group">
                        <legend>@key.Label</legend>
                        <input type="hidden" name="@InnovestHolding.Controllers.Admin.ContentController.PageListMarker(key.Key)" value="1" />
                        @foreach (var choice in choices)
                        {
                            <label class="form-check"><input type="checkbox" name="@InnovestHolding.Controllers.Admin.ContentController.PageListField(key.Key)" value="@choice.Key" checked="@selected.Contains(choice.Key)" /> @choice.Value</label>
                        }
                        <p class="form-hint">تظهر بترتيب قائمة الصفحات. الصفحة غير المنشورة تُتخطّى.</p>
                    </fieldset>
                }
                else if (key.Rule == ContentRule.PageKey)
                {
                    var choices = ViewData[InnovestHolding.Controllers.Admin.ContentController.PageChoicesKey] as IReadOnlyList<KeyValuePair<string, string>> ?? [];
                    var id = "content-" + key.Key.Replace('_', '-');
                    <div class="form-group">
                        <label for="@id">@key.Label</label>
                        <select id="@id" name="content[@key.Key].Ar" class="form-control">
                            @if (!choices.Any(c => c.Key == value.Ar?.Trim()))
                            {
                                <option value="@value.Ar" selected>@value.Ar</option>
                            }
                            @foreach (var choice in choices)
                            {
                                <option value="@choice.Key" selected="@(choice.Key == value.Ar?.Trim())">@choice.Value</option>
                            }
                        </select>
                    </div>
                }
                else if (key.Neutral)
                {
                    <lang-pair label="@key.Label" name-ar="content[@key.Key].Ar" value-ar="@value.Ar" max="@key.MaxLength" rows="@rows" ltr="true" required="@(!key.AllowEmpty)" />
                }
                else
                {
                    <lang-pair label="@key.Label" name-ar="content[@key.Key].Ar" name-en="content[@key.Key].En" value-ar="@value.Ar" value-en="@value.En" max="@key.MaxLength" rows="@rows" required="@(!key.AllowEmpty && !key.Optional)" hint-key="@key.HintKey" />
                }
            }
        </div>
    }

    <div class="sticky-actions">
        <button type="submit" class="btn-admin btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            حفظ التعديلات
        </button>
        <a href="/" target="_blank" rel="noopener" class="btn-admin btn-secondary">معاينة العربية</a>
        <a href="/en" target="_blank" rel="noopener" class="btn-admin btn-secondary">معاينة الإنجليزية</a>
    </div>
</form>
