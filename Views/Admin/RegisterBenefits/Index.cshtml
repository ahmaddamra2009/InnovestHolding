@model List<RegisterBenefit>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "مزايا التسجيل"; }
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">إضافة ميزة جديدة (النقاط في قسم التسجيل)</span></div>
    <form method="post" asp-action="Create" asp-controller="RegisterBenefits">
        <lang-pair label="نص الميزة" name-ar="TextAr" name-en="TextEn" max="200" required="true" id-prefix="new-" />
        <button type="submit" class="btn-admin btn-primary">إضافة</button>
    </form>
</div>
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">المزايا (@Model.Count)</span></div>
    @if (!Model.Any())
    {
        <p style="text-align:center;color:var(--admin-text-muted);padding:40px 0;">لا توجد مزايا حتى الآن</p>
    }
    @foreach (var item in Model)
    {
        <form method="post" asp-action="Update" asp-controller="RegisterBenefits" class="row-form">
            <input type="hidden" name="id" value="@item.Id">
            <div class="row-form-head">
                <strong>@item.TextAr</strong>
                <partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="@(!string.IsNullOrWhiteSpace(item.TextEn))" />
                @if (item.IsActive) { <span class="badge-active">مفعّل</span> } else { <span class="badge-inactive">معطّل</span> }
            </div>
            <lang-pair label="نص الميزة" name-ar="TextAr" name-en="TextEn" value-ar="@item.TextAr" value-en="@item.TextEn" max="200" required="true" id-prefix="b@(item.Id)-" />
            <div class="inline-form">
                <div class="form-group"><label>الترتيب</label><input type="number" name="SortOrder" value="@item.SortOrder" class="form-control" min="0" max="100000"></div>
                <div class="form-check"><input type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "")> <label>مفعّل</label></div>
                <button type="submit" class="btn-admin btn-primary btn-sm">حفظ</button>
            </div>
        </form>
        <form method="post" asp-action="Delete" asp-controller="RegisterBenefits" style="margin:-8px 0 16px;">
            <input type="hidden" name="id" value="@item.Id">
            <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذه الميزة؟')">حذف</button>
        </form>
    }
</div>
