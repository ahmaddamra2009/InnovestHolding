@model InnovestHolding.Controllers.Admin.PagesIndexVm
@using InnovestHolding.Infrastructure.Site
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "صفحات الموقع"; }
<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">صفحات الموقع (@SiteRoutes.All.Count)</span>
    </div>
    <p class="form-hint" style="margin-bottom:12px;">عنوان الصفحة ونصوصها ونص «قريباً» وبيانات محركات البحث والظهور في الفوتر تُعدّل من «تعديل». إخفاء صفحة من القائمة لا يحذفها: تبقى متاحة برابطها. الصفحة غير المنشورة (والصفحات التابعة لها) تُظهر صفحة «غير موجودة».</p>
    <div class="table-scroll">
    <table class="admin-table page-tree">
        <thead><tr><th>الصفحة</th><th>الرابط</th><th>النشر</th><th>في القائمة</th><th>EN</th><th>الترتيب</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var (pg, depth) in Model.Tree())
        {
            var row = Model.Rows.GetValueOrDefault(pg.Key);
            var url = SiteRoutes.PathFor(pg, false);
            var enDone = row is not null && !string.IsNullOrWhiteSpace(row.TitleEn) && !string.IsNullOrWhiteSpace(row.MetaTitleEn) && !string.IsNullOrWhiteSpace(row.MetaDescriptionEn);
            var siblings = Model.Siblings(pg);
            <tr class="@(row is { IsPublished: false } ? "row-hidden" : null)">
                <td class="depth-@depth">
                    <strong>@(row?.TitleAr ?? pg.Key)</strong>
                    <div class="page-key">@pg.Key</div>
                </td>
                <td><a href="@url" target="_blank" rel="noopener" class="page-key">@url</a></td>
                <td>
                    @if (pg.Key == PageKeys.Home)
                    {
                        <span class="badge-active">دائماً</span>
                    }
                    else if (row is not null)
                    {
                        <form method="post" asp-action="TogglePublished" asp-controller="Pages" asp-route-id="@pg.Key" class="visible-switch">
                            <button type="submit" class="@(row.IsPublished ? "badge-active" : "badge-inactive")" aria-pressed="@(row.IsPublished ? "true" : "false")" title="تبديل نشر «@row.TitleAr»">@(row.IsPublished ? "منشورة" : "غير منشورة")</button>
                        </form>
                    }
                </td>
                <td>
                    @if (pg.Key == PageKeys.Home)
                    {
                        <span class="badge-active">دائماً</span>
                    }
                    else if (row is not null)
                    {
                        <form method="post" asp-action="ToggleMenu" asp-controller="Pages" asp-route-id="@pg.Key" class="visible-switch">
                            <button type="submit" class="@(row.ShowInMenu ? "badge-active" : "badge-inactive")" aria-pressed="@(row.ShowInMenu ? "true" : "false")" title="تبديل الظهور في القائمة">@(row.ShowInMenu ? "ظاهرة" : "مخفية")</button>
                        </form>
                    }
                </td>
                <td><partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="enDone" /></td>
                <td>
                    @if (pg.Parent is not null && row is not null)
                    {
                        <partial name="~/Views/Admin/Shared/_ReorderCell.cshtml"
                                 model="@(new ReorderCellVm("Pages", pg.Key, row.TitleAr, siblings.IndexOf(pg.Key) + 1, siblings.Count))" />
                    }
                </td>
                <td>
                    <div class="inline-actions">
                        <a href="/Admin/Pages/Edit/@pg.Key" class="btn-admin btn-secondary btn-sm">@(row is null ? "إنشاء" : "تعديل")</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
