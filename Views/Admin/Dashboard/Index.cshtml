@model DashboardViewModel
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "نظرة عامة"; }

<div class="stats-cards">
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalEvents</h3><p>الفعاليات</p></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalNews</h3><p>الأخبار</p></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalPartners</h3><p>الشركاء</p></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalPlatforms</h3><p>الخدمات</p></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalFaqs</h3><p>الأسئلة الشائعة</p></div>
    </div>
    <div class="stat-card-admin">
        <div class="stat-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalNavItems</h3><p>روابط إضافية في القائمة</p></div>
    </div>
    <div class="stat-card-admin" style="@(Model.UnreadRegistrations > 0 ? "border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.02);" : "")">
        <div class="stat-card-icon" style="@(Model.UnreadRegistrations > 0 ? "background:linear-gradient(135deg, rgba(239,68,68,0.1), rgba(239,68,68,0.05));" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="@(Model.UnreadRegistrations > 0 ? "#ef4444" : "currentColor")" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalRegistrations</h3><p>التسجيلات @(Model.UnreadRegistrations > 0 ? $"({Model.UnreadRegistrations} جديد)" : "")</p></div>
    </div>
    <div class="stat-card-admin" style="@(Model.UnreadMessages > 0 ? "border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.02);" : "")">
        <div class="stat-card-icon" style="@(Model.UnreadMessages > 0 ? "background:linear-gradient(135deg, rgba(239,68,68,0.1), rgba(239,68,68,0.05));" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="@(Model.UnreadMessages > 0 ? "#ef4444" : "currentColor")" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div class="stat-card-info"><h3>@Model.TotalMessages</h3><p>رسائل التواصل @(Model.UnreadMessages > 0 ? $"({Model.UnreadMessages} جديد)" : "")</p></div>
    </div>
</div>

@if (Model.UnreadLeads is { } leads)
{
    <div class="admin-card">
        <div class="admin-card-header">
            <span class="admin-card-title">الطلبات غير المقروءة (@leads.Leads)</span>
            <a href="/Admin/Leads" class="btn-admin btn-secondary btn-sm">كل الطلبات</a>
        </div>
        <div class="stats-cards">
            @foreach (var (key, label) in InnovestHolding.Infrastructure.Leads.LeadInbox.Types)
            {
                var count = leads.Of(key);
                <a class="stat-card-admin lead-type-card@(count > 0 ? " has-unread" : "")" href="/Admin/Leads?type=@key&amp;status=unread">
                    <div class="stat-card-info"><h3>@count</h3><p>@label — غير مقروء</p></div>
                </a>
            }
        </div>
    </div>
}

<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">مرحباً بك في لوحة التحكم</span>
    </div>
    <p style="color:var(--admin-text-muted);line-height:2;">
        من هنا يمكنك إدارة كل محتوى موقع <strong>إنوفست هولدينغ</strong> باللغتين. استخدم القائمة الجانبية للتنقل بين الأقسام: صفحات الموقع (ومنها إظهار الصفحة في القائمة)، النصوص العامة والقوائم، الخدمات والأرقام والأسئلة الشائعة، منتدى إنوفست العربي وشبكة المستثمرين الملائكيين والبرنامج التلفزيوني، الأخبار، والطلبات ورسائل التواصل الواردة من النماذج.
    </p>
</div>
