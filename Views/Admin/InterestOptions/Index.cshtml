@model List<InterestOption>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "خيارات مجال الاهتمام"; }
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">إضافة خيار جديد (قائمة «مجال الاهتمام» في نموذج التسجيل)</span></div>
    <form method="post" asp-action="Create" asp-controller="InterestOptions">
        <lang-pair label="اسم الخيار" name-ar="NameAr" name-en="NameEn" max="100" required="true" id-prefix="new-" />
        <button type="submit" class="btn-admin btn-primary">إضافة</button>
    </form>
</div>
<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">الخيارات (@Model.Count)</span></div>
    @if (!Model.Any())
    {
        <p style="text-align:center;color:var(--admin-text-muted);padding:40px 0;">لا توجد خيارات حتى الآن — يُخفى حقل «مجال الاهتمام» من النموذج</p>
    }
    @foreach (var item in Model)
    {
        <form method="post" asp-action="Update" asp-controller="InterestOptions" class="row-form">
            <input type="hidden" name="id" value="@item.Id">
            <div class="row-form-head">
                <strong>@item.NameAr</strong>
                <partial name="~/Views/Admin/Shared/_EnChip.cshtml" model="@(!string.IsNullOrWhiteSpace(item.NameEn))" />
                @if (item.IsActive) { <span class="badge-active">مفعّل</span> } else { <span class="badge-inactive">معطّل</span> }
            </div>
            <lang-pair label="اسم الخيار" name-ar="NameAr" name-en="NameEn" value-ar="@item.NameAr" value-en="@item.NameEn" max="100" required="true" id-prefix="o@(item.Id)-" />
            <div class="inline-form">
                <div class="form-group"><label>الترتيب</label><input type="number" name="SortOrder" value="@item.SortOrder" class="form-control" min="0" max="100000"></div>
                <div class="form-check"><input type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "")> <label>مفعّل</label></div>
                <button type="submit" class="btn-admin btn-primary btn-sm">حفظ</button>
            </div>
        </form>
        <form method="post" asp-action="Delete" asp-controller="InterestOptions" style="margin:-8px 0 16px;">
            <input type="hidden" name="id" value="@item.Id">
            <button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا الخيار؟ تبقى التسجيلات السابقة بنصها المحفوظ.')">حذف</button>
        </form>
    }
</div>
