@model NewsEditInput
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "تعديل الخبر"; }
<div class="admin-card">
    <form method="post" asp-action="Edit" asp-controller="News" enctype="multipart/form-data">
        @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }
        <input type="hidden" asp-for="Id">
        <partial name="~/Views/Admin/News/_Fields.cshtml" model="Model" />
        <div class="form-group" style="max-width:200px;"><label>الترتيب (الأصغر أولاً)</label><input asp-for="SortOrder" type="number" class="form-control" min="-100000" max="100000"><span asp-validation-for="SortOrder" class="field-error"></span></div>
        <div class="form-check" style="margin-bottom:20px;"><input asp-for="IsActive"> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ التعديلات</button>
        <a href="/Admin/News" class="btn-admin btn-secondary" style="margin-inline-start:12px;">إلغاء</a>
    </form>
</div>
