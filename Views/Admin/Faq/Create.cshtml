@model FaqInput
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إضافة سؤال جديد"; }
<div class="admin-card">
    <form method="post" asp-action="Create" asp-controller="Faq">
        @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }
        <div class="form-group"><label>السؤال</label><input asp-for="Question" class="form-control" maxlength="1000" required><span asp-validation-for="Question" class="field-error"></span></div>
        <div class="form-group"><label>الجواب</label><textarea asp-for="Answer" class="form-control" rows="4" maxlength="4000" required></textarea><span asp-validation-for="Answer" class="field-error"></span></div>
        <div class="form-check" style="margin-bottom:20px;"><input asp-for="IsActive"> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ</button>
        <a href="/Faq" class="btn-admin btn-secondary" style="margin-right:12px;">إلغاء</a>
    </form>
</div>
