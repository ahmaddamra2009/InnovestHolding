@model List<Faq>
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "إدارة الأسئلة الشائعة"; }
<div class="admin-card">
    <div class="admin-card-header">
        <span class="admin-card-title">الأسئلة الشائعة (@Model.Count)</span>
        <a href="/Faq/Create" class="btn-admin btn-primary btn-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> إضافة سؤال</a>
    </div>
    <table class="admin-table">
        <thead><tr><th>السؤال</th><th>الحالة</th><th>إجراءات</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Question</strong></td>
                <td>@(item.IsActive ? Html.Raw("<span class='badge-active'>مفعّل</span>") : Html.Raw("<span class='badge-inactive'>معطّل</span>"))</td>
                <td class="actions">
                    <a href="/Faq/Edit/@item.Id" class="btn-admin btn-secondary btn-sm">تعديل</a>
                    <form method="post" asp-action="Delete" asp-controller="Faq" style="display:inline;"><input type="hidden" name="id" value="@item.Id"><button type="submit" class="btn-admin btn-danger btn-sm" onclick="return confirm('حذف هذا السؤال؟')">حذف</button></form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
