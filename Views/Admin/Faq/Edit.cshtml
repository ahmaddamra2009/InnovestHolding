@model FaqEditInput
@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "تعديل السؤال"; }
<div class="admin-card">
    <form method="post" asp-action="Edit" asp-controller="Faq">
        @if (!ViewData.ModelState.IsValid) { <div class="form-errors" asp-validation-summary="All"></div> }
        <input type="hidden" asp-for="Id">
        <lang-pair label="السؤال" name-ar="QuestionAr" name-en="QuestionEn" value-ar="@Model.QuestionAr" value-en="@Model.QuestionEn" max="1000" required="true" />
        <lang-pair label="الجواب" name-ar="AnswerAr" name-en="AnswerEn" value-ar="@Model.AnswerAr" value-en="@Model.AnswerEn" max="4000" rows="4" required="true" />
        <div class="form-group" style="max-width:200px;"><label>الترتيب</label><input asp-for="SortOrder" type="number" class="form-control" min="0" max="100000"><span asp-validation-for="SortOrder" class="field-error"></span></div>
        <div class="form-check" style="margin-bottom:20px;"><input asp-for="IsActive"> <label>مفعّل</label></div>
        <button type="submit" class="btn-admin btn-primary">حفظ التعديلات</button>
        <a href="/Admin/Faq" class="btn-admin btn-secondary" style="margin-inline-start:12px;">إلغاء</a>
    </form>
</div>
