@{ Layout = "~/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "الإعدادات"; }

<div class="admin-card">
    <div class="admin-card-header"><span class="admin-card-title">تغيير كلمة المرور</span></div>
    <form method="post" asp-action="ChangePassword" asp-controller="Settings" style="max-width:500px;">
        <div class="form-group"><label>كلمة المرور الحالية</label><input type="password" name="currentPassword" class="form-control" required></div>
        <div class="form-group"><label>كلمة المرور الجديدة</label><input type="password" name="newPassword" class="form-control" required></div>
        <div class="form-group"><label>تأكيد كلمة المرور الجديدة</label><input type="password" name="confirmPassword" class="form-control" required></div>
        <button type="submit" class="btn-admin btn-primary">تغيير كلمة المرور</button>
    </form>
</div>
