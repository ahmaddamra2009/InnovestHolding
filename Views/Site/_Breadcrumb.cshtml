@model IReadOnlyList<BreadcrumbVm>
@* The visible breadcrumb (its JSON-LD twin is built from the same list). Middle steps collapse under 640 px. *@
@{ var crumbs = Model; }
@if (crumbs.Count > 0)
{
  <nav class="breadcrumb" aria-label="@L[K.Ui.BreadcrumbAria]">
    <ol>
      @for (var i = 0; i < crumbs.Count; i++)
      {
        var c = crumbs[i];
        var collapse = i > 0 && i < crumbs.Count - 2;
        <li class="@(collapse ? "crumb-mid" : null)">
          @if (c.Href is not null)
          {
            <a href="@c.Href" lang="@c.Title.Lang" dir="@c.Title.Dir">@c.Title</a>
          }
          else
          {
            <span aria-current="page" lang="@c.Title.Lang" dir="@c.Title.Dir">@c.Title</span>
          }
        </li>
      }
    </ol>
  </nav>
}
