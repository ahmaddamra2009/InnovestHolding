@model DetailPageVm
@using InnovestHolding.Infrastructure.Content
@* A news item or an event: title band with the breadcrumb, the facts row, the image, the text, and an action card.
   Every value is a database text resolved for the page language (Arabic fallback marked lang/dir). *@
@{
    ViewData["Seo"] = Model.Seo;
    ViewData["Shell"] = Model.Shell;
}
<section class="page-hero detail-hero">
  <span class="hero-tri hero-tri-a" aria-hidden="true"></span>
  <span class="hero-tri hero-tri-b" aria-hidden="true"></span>
  <div class="container">
    <partial name="~/Views/Site/_Breadcrumb.cshtml" model="Model.Shell.Breadcrumbs" />
    @if (!Model.Badge.IsEmpty)
    {
      <span class="detail-badge" lang="@Model.Badge.Lang" dir="@Model.Badge.Dir">@Model.Badge</span>
    }
    <h1 class="page-title" lang="@Model.Title.Lang" dir="@Model.Title.Dir">@Model.Title</h1>
    @if (Model.Facts.Count > 0)
    {
      <ul class="detail-facts">
        @foreach (var fact in Model.Facts)
        {
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(Icons.Svg(fact.Icon))</svg>
            <span class="visually-hidden">@fact.Label:</span>
            @if (fact.Href is not null)
            {
              <a href="@fact.Href" rel="noopener" lang="@fact.Text.Lang" dir="@fact.Text.Dir">@fact.Text</a>
            }
            else
            {
              <span lang="@fact.Text.Lang" dir="@fact.Text.Dir">@fact.Text</span>
            }
          </li>
        }
      </ul>
    }
  </div>
</section>

<section class="page-section detail-section">
  <div class="container detail-layout">
    <article class="detail-main">
      @if (Model.ArabicOnly)
      {
        <p class="detail-notice">@L[K.Ui.ArabicOnlyNotice]</p>
      }
      @if (!Model.Notice.IsEmpty)
      {
        <p class="detail-notice is-muted">@Model.Notice</p>
      }
      @if (Model.Video is { YouTubeId: { } videoId } video)
      {
        @* Click-to-load player: the page holds only the id; main.js builds the privacy-enhanced player on the click,
           so nothing is requested from YouTube before it. *@
        <div class="video-facade" data-video-id="@videoId" data-video-title="@video.Title">
          @if (video.Poster is { } poster)
          {
            <img class="video-poster" src="@poster.Src" width="@poster.Width" height="@poster.Height" alt="@poster.Alt" lang="@poster.Alt.Lang" fetchpriority="high" decoding="async">
          }
          else
          {
            <div class="video-poster is-blank" aria-hidden="true"><span class="tri-mark tri-mark-lg"></span></div>
          }
          <button type="button" class="video-play" aria-label="@L[K.Ui.PlayVideo, video.Title.Value]">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="8 5 19 12 8 19 8 5" fill="currentColor"/></svg>
          </button>
        </div>
        <p class="video-note">@L[K.Ui.VideoNotice]
          @if (video.LinkUrl is { } youTubeLink)
          {
            @* A plain link (no request until followed): the video is reachable without the script. *@
            <a href="@youTubeLink" rel="noopener noreferrer" class="video-link">@L[K.Ui.WatchOnYouTube]<span class="visually-hidden"> @L[K.Ui.ExternalLink]</span></a>
          }
        </p>
      }
      @if (Model.Image is { } img)
      {
        @* The page's main image: loaded eagerly (likely the LCP element). A person's photo is a round portrait. *@
        <figure class="detail-figure@(Model.Portrait ? " is-portrait" : "")">
          <img src="@img.Src" width="@img.Width" height="@img.Height" alt="@img.Alt" lang="@img.Alt.Lang" fetchpriority="high" decoding="async">
        </figure>
      }
      @if (!Model.Lead.IsEmpty)
      {
        <p class="detail-lead" lang="@Model.Lead.Lang" dir="@Model.Lead.Dir">@Model.Lead</p>
      }
      @foreach (var p in Model.Body)
      {
        <p lang="@p.Lang" dir="@p.Dir">@ContentText.Lines(p)</p>
      }
    </article>
    <aside class="detail-aside">
      <div class="detail-card">
        @if (Model.Video is { YouTubeId: null, LinkUrl: { } watch })
        {
          @* An address on another site, entered by the admin: no referrer, marked as external. *@
          <a href="@watch" class="btn btn-accent" rel="noopener noreferrer">@L[K.Ui.WatchVideo]
            <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg><span class="visually-hidden"> @L[K.Ui.ExternalLink]</span></a>
        }
        @if (Model.Profiles.Count > 0)
        {
          <ul class="detail-profiles" aria-label="@L[K.Ui.ProfilesAria, Model.Title.Value]">
            @foreach (var s in Model.Profiles)
            {
              var icon = SocialIcons.All[s.Network];
              <li><a href="@s.Url" rel="noopener me" aria-label="@icon.Name"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(icon.Svg)</svg></a></li>
            }
          </ul>
        }
        @foreach (var action in Model.Actions)
        {
          var external = action.Href.StartsWith("http", StringComparison.OrdinalIgnoreCase);
          <a href="@action.Href" class="btn btn-accent" rel="@(external ? "noopener" : null)" lang="@action.Title.Lang" dir="@action.Title.Dir">@action.Title</a>
        }
        <a href="@Model.Back.Href" class="btn btn-outline" lang="@Model.Back.Title.Lang" dir="@Model.Back.Title.Dir">
          <svg class="i-dir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          @Model.Back.Title
        </a>
      </div>
    </aside>
  </div>
</section>

@foreach (var related in Model.Related)
{
  <section class="page-section is-cream detail-related">
    <div class="container">
      <div class="block-head">
        <h2 class="block-title" lang="@related.Title.Lang" dir="@related.Title.Dir">@related.Title</h2>
      </div>
      <partial name="Blocks/_EntityGrid" model="new EntityGridBlock(Model.Kind, related.Cards, null, related.People)" />
    </div>
  </section>
}
