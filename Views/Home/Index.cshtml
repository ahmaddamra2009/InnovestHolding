@model HomeViewModel
@using InnovestHolding.Infrastructure.Content
@using InnovestHolding.Infrastructure.Seo
@using InnovestHolding.Infrastructure.Site
@{
    ViewData["Seo"] = Model.Seo;
    ViewData["Shell"] = Model.Shell;
    var c = Model.Content;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

  <!-- 1. HERO (fixed: the page's only h1; its figures row is the hide-only section "hero_stats") -->
  @{
    var kicker = c.Optional("hero_kicker");
    var heroTitle = c.Text("hero_title");
    var heroBadge = c.Text("hero_badge");
    var heroSubtitle = c.Text("hero_subtitle");
  }
  <section class="hero-section" id="hero">
    <div class="hero-pattern" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-layout">
      <div class="hero-content">
        <div class="hero-logo-badge reveal">
          <span class="tri-bullet" aria-hidden="true"></span>
          <span lang="@heroBadge.Lang" dir="@heroBadge.Dir">@heroBadge</span>
        </div>

        <h1 class="hero-title reveal reveal-delay-1" lang="@heroTitle.Lang" dir="@heroTitle.Dir">
          @if (!kicker.IsEmpty)
          {
            <span class="hero-title-en">@kicker</span>
          }
          @heroTitle
        </h1>

        <p class="hero-subtitle reveal reveal-delay-2" lang="@heroSubtitle.Lang" dir="@heroSubtitle.Dir">@heroSubtitle</p>

        @if (Model.HeroMain is not null || Model.HeroSecondary is not null)
        {
        <div class="hero-buttons reveal reveal-delay-3">
          @if (Model.HeroMain is { } main)
          {
          <a href="@main.Href" class="btn btn-accent" rel="@main.Rel">
            <span lang="@main.Title.Lang" dir="@main.Title.Dir">@main.Title</span>
            <svg class="i-dir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(HomeViewModel.Arrow)</svg>
          </a>
          }
          @if (Model.HeroSecondary is { } second)
          {
          <a href="@second.Href" class="btn btn-outline-light" rel="@second.Rel">
            <span lang="@second.Title.Lang" dir="@second.Title.Dir">@second.Title</span>
          </a>
          }
        </div>
        }

        @if (Model.HeroStats.Count > 0)
        {
          <div class="hero-stats reveal reveal-delay-4">
            @foreach (var stat in Model.HeroStats)
            {
              <div class="hero-stat">
                <div class="hero-stat-number" data-counter="@stat.Value.ToString(inv)" data-suffix="@stat.Suffix">@stat.Value.ToString("N0", inv)@stat.Suffix</div>
                <div class="hero-stat-label" lang="@stat.ShortLabel.Lang" dir="@stat.ShortLabel.Dir">@stat.ShortLabel</div>
              </div>
            }
          </div>
        }
      </div>
      @if (Model.Shell.Brand.Hero is { } hero)
      {
        @* The hero image the admin uploaded (Content editor); its alt text is the admin's, else decorative. *@
        var heroAlt = Bilingual.Optional(hero.AltAr, hero.AltEn, Model.Shell.IsEnglish);
        <div class="hero-art">
          <img src="@hero.Url" width="@hero.Width" height="@hero.Height" alt="@heroAlt" class="hero-triangle hero-image" fetchpriority="high" decoding="async">
        </div>
      }
      else
      {
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 400 360" class="hero-triangle">
          <defs>
            <linearGradient id="tri-glow" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color:var(--orange-glow-1)"/><stop offset=".55" style="stop-color:var(--orange)"/><stop offset="1" style="stop-color:var(--orange-glow-3)"/>
            </linearGradient>
            <linearGradient id="tri-edge" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color:var(--white)" stop-opacity=".55"/><stop offset="1" style="stop-color:var(--white)" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <polygon points="40,40 360,40 200,320" fill="url(#tri-glow)"/>
          <polygon points="40,40 360,40 200,140" fill="url(#tri-edge)" opacity=".35"/>
          <polygon points="200,140 360,40 200,320" fill="#000" opacity=".12"/>
        </svg>
      </div>
      }
    </div>
  </section>

  @* The other sections in the admin's order (Admin › PageSections, page "home"). A hidden or empty section leaves only its
     anchor, so old /#news links still land; nothing on the page links to it. *@
  @foreach (var part in Model.Sections)
  {
    if (!part.Render)
    {
      if (part.Anchor is not null)
      {
        <span id="@part.Anchor" class="section-anchor"></span>
      }
      continue;
    }
    switch (part.Key)
    {
      case "about": <partial name="Sections/_About" model="Model" /> break;
      case "ecosystem": <partial name="Sections/_Ecosystem" model="Model" /> break;
      case "platforms": <partial name="Sections/_Platforms" model="Model" /> break;
      case "stats": <partial name="Sections/_Stats" model="Model" /> break;
      case "events": <partial name="Sections/_Events" model="Model" /> break;
      case "news": <partial name="Sections/_News" model="Model" /> break;
      case "partners": <partial name="Sections/_Partners" model="Model" /> break;
      case "faq": <partial name="Sections/_Faq" model="Model" /> break;
      case "register": <partial name="Sections/_Register" model="Model" /> break;
      case "contact": <partial name="Sections/_Contact" model="Model" /> break;
      case "cta_band": <partial name="Blocks/_Misc" model="Model.CtaBand" /> break;
    }
  }
