@model HomeViewModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "الصفحة الرئيسية"; }



  <!-- ==========================================
       HEADER / NAVIGATION
       ========================================== -->
  <header id="main-header">
    <div class="container nav-container">
      <!-- Logo Area (Right in RTL) -->
      <a href="#hero" class="logo-area">
        <img src="~/assets/logo.png" alt="Innovest Holding" class="logo-img">
      </a>

      <!-- Navigation Links (Center) -->
      <nav class="nav-links">
        <a href="#hero" class="nav-link active">الرئيسية</a>
        <a href="#about" class="nav-link">من نحن</a>
        
        <!-- Dropdown: منصاتنا -->
        <div class="nav-dropdown">
          <a href="#platforms" class="nav-link">
            منصاتنا
            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <div class="dropdown-menu">
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              التدريب والتعليم
            </a>
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              منصة المستثمرين والتشبيك
            </a>
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
              الإعلام والمحتوى الرقمي
            </a>
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 9 7 12 7s5-3 7.5-3a2.5 2.5 0 0 1 0 5H18"/><path d="M12 7v10"/><path d="M6 21h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2z"/></svg>
              المسابقات
            </a>
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              الفعاليات والمعارض
            </a>
            <a href="#platforms" class="dropdown-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              الشراكات الاستراتيجية و B2B
            </a>
          </div>
        </div>
        
        <a href="#news" class="nav-link">الأخبار</a>
        <a href="#events" class="nav-link">الفعاليات</a>
        <a href="#partners" class="nav-link">الشركاء والرعاة</a>
        <a href="#register" class="nav-link">التسجيل السريع</a>
        <a href="#contact" class="nav-link">تواصل معنا</a>
      </nav>

      <!-- Actions (Left in RTL) -->
      <div class="nav-actions">
        <button class="btn-lang" aria-label="تغيير اللغة">EN</button>
        <a href="#register" class="nav-cta">سجّل الآن</a>
        
        <!-- Hamburger -->
        <div class="hamburger" id="hamburger-menu">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-overlay" id="nav-overlay"></div>
  <div class="mobile-nav" id="mobile-nav-drawer">
    <nav class="nav-links">
      <a href="#hero" class="nav-link active">الرئيسية</a>
      <a href="#about" class="nav-link">من نحن</a>
      <a href="#platforms" class="nav-link mobile-dropdown-trigger">
        منصاتنا
        <svg class="dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </a>
      <div class="mobile-dropdown-items">
        <a href="#platforms">التدريب والتعليم</a>
        <a href="#platforms">منصة المستثمرين والتشبيك</a>
        <a href="#platforms">الإعلام والمحتوى الرقمي</a>
        <a href="#platforms">المسابقات</a>
        <a href="#platforms">الفعاليات والمعارض</a>
        <a href="#platforms">الشراكات الاستراتيجية</a>
      </div>
      <a href="#news" class="nav-link">الأخبار</a>
      <a href="#events" class="nav-link">الفعاليات</a>
      <a href="#partners" class="nav-link">الشركاء والرعاة</a>
      <a href="#register" class="nav-link">التسجيل السريع</a>
      <a href="#contact" class="nav-link">تواصل معنا</a>
    </nav>
    <a href="#register" class="btn btn-gold" style="width:100%; text-align:center;">سجّل الآن</a>
  </div>

  <!-- ==========================================
       1. HERO SECTION
       ========================================== -->
  <section class="hero-section" id="hero">
    <!-- Background elements -->
    <div class="hero-pattern"></div>
    <div class="hero-accent-line"></div>
    <div class="hero-accent-line"></div>
    <div class="hero-glow"></div>
    
    <div class="hero-content">
      <div class="hero-logo-badge reveal">
        <img src="~/assets/logo.png" alt="Innovest" style="height:48px;border-radius:8px;">
        <span>مرحباً بكم في إنوفست هولدينغ</span>
      </div>
      
      <h1 class="hero-title reveal reveal-delay-1">
        <span class="hero-title-en">INNOVEST HOLDING</span>
        إنوفست هولدينغ
      </h1>
      
      <p class="hero-subtitle reveal reveal-delay-2">
        نبني جسور الاستثمار والابتكار من خلال منصات متكاملة للتدريب والتعليم والاستثمار والفعاليات والشراكات الاستراتيجية
      </p>
      
      <div class="hero-buttons reveal reveal-delay-3">
        <a href="#platforms" class="btn btn-gold">
          اكتشف منصاتنا
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        </a>
        <a href="#register" class="btn btn-gold-outline">
          سجّل الآن
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
        </a>
      </div>
      
      <div class="hero-stats reveal reveal-delay-4">
        <div class="hero-stat">
          <div class="hero-stat-number" data-counter="150" data-suffix="+">0</div>
          <div class="hero-stat-label">شريك استراتيجي</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-number" data-counter="2500" data-suffix="+">0</div>
          <div class="hero-stat-label">مستثمر</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-number" data-counter="80" data-suffix="+">0</div>
          <div class="hero-stat-label">فعالية سنوياً</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-number" data-counter="5000" data-suffix="+">0</div>
          <div class="hero-stat-label">متدرب ومستفيد</div>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="hero-scroll-indicator">
      <span>اكتشف المزيد</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 13 12 18 17 13"/><polyline points="7 6 12 11 17 6"/></svg>
    </div>
  </section>

  <!-- ==========================================
       2. ABOUT SECTION
       ========================================== -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="about-grid">
        <!-- Image -->
        <div class="about-image-wrap reveal-right">
          <div style="width:100%;aspect-ratio:4/3;border-radius:var(--radius-xl);background:linear-gradient(135deg, #1a1d4a 0%, #252963 50%, #15183f 100%);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-lg);position:relative;overflow:hidden;">
            <!-- Decorative pattern inside -->
            <div style="position:absolute;top:0;left:0;width:100%;height:100%;opacity:0.05;background-image:radial-gradient(circle at 30% 40%, rgba(184,115,50,0.4) 0%, transparent 50%),radial-gradient(circle at 70% 60%, rgba(184,115,50,0.3) 0%, transparent 50%);"></div>
            <div style="text-align:center;position:relative;z-index:2;padding:40px;">
              <img src="~/assets/logo.png" alt="Innovest Holding" style="height:128px;width:auto;margin:0 auto 24px;border-radius:0;">
              <div style="color:rgba(255,255,255,0.5);font-size:1rem;font-weight:600;">نبني جسور الاستثمار والابتكار</div>
            </div>
          </div>
          <div class="about-image-accent"></div>
          <div class="about-experience-badge">
            <div class="badge-number">+10</div>
            <div class="badge-text">سنوات من<br>الخبرة والإنجاز</div>
          </div>
        </div>
        
        <!-- Content -->
        <div class="about-content reveal-left">
          <span class="section-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            من نحن
          </span>
          <h2 class="section-title">
            نحن <span class="gold gold-underline">إنوفست هولدينغ</span>
          </h2>
          <p class="about-text">
            إنوفست هولدينغ هي شركة رائدة في مجال الاستثمار والابتكار، تأسست برؤية طموحة لبناء منظومة متكاملة تجمع بين التدريب والتعليم، والاستثمار، والتشبيك، والفعاليات. نسعى لتمكين رواد الأعمال والمستثمرين والشركات من خلال منصات متخصصة توفر بيئة محفزة للنمو والتطور.
          </p>
          <p class="about-text">
            نعمل على تقديم حلول مبتكرة تلبي احتياجات السوق المتنامية، مع التركيز على الجودة والاحترافية في كل ما نقدمه من خدمات ومنصات.
          </p>
          
          <div class="about-values">
            <div class="value-card reveal reveal-delay-1">
              <div class="value-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              </div>
              <h4>الرؤية</h4>
              <p>أن نكون المنصة الأولى للاستثمار والابتكار في المنطقة</p>
            </div>
            <div class="value-card reveal reveal-delay-2">
              <div class="value-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h4>الرسالة</h4>
              <p>تمكين الأفراد والشركات عبر منصات متكاملة ومبتكرة</p>
            </div>
            <div class="value-card reveal reveal-delay-3">
              <div class="value-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <h4>القيم</h4>
              <p>الابتكار والجودة والشفافية والتميز المستمر</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       3. PLATFORMS / SERVICES SECTION
       ========================================== -->
  <section class="platforms-section" id="platforms">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          منصاتنا
        </span>
        <h2 class="section-title">منصاتنا <span class="gold gold-underline">المتكاملة</span></h2>
        <p class="section-subtitle">نقدم مجموعة متنوعة من المنصات المتخصصة المصممة لتلبية احتياجاتكم في التدريب والاستثمار والتشبيك والفعاليات</p>
      </div>
      
      <div class="platforms-grid">
        <!-- Platform 1: Training & Education -->
        <div class="platform-card reveal reveal-delay-1">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3>التدريب والتعليم</h3>
          <p>برامج تدريبية متخصصة وورش عمل احترافية مصممة لتطوير المهارات وبناء القدرات في مجالات الأعمال والتكنولوجيا والقيادة.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        
        <!-- Platform 2: Investor & Networking -->
        <div class="platform-card reveal reveal-delay-2">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>منصة المستثمرين والتشبيك</h3>
          <p>منصة فريدة تربط بين المستثمرين ورواد الأعمال والشركات، وتوفر فرص تشبيك استراتيجية وشراكات مثمرة.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        
        <!-- Platform 3: Media & Digital Content -->
        <div class="platform-card reveal reveal-delay-3">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          </div>
          <h3>الإعلام والمحتوى الرقمي</h3>
          <p>إنتاج محتوى رقمي إبداعي ومتميز، يشمل الفيديو والبودكاست والمقالات المتخصصة في عالم الأعمال والاستثمار.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        
        <!-- Platform 4: Competitions -->
        <div class="platform-card reveal reveal-delay-4">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5C7 4 9 7 12 7s5-3 7.5-3a2.5 2.5 0 0 1 0 5H18"/><path d="M12 7v10"/><path d="M6 21h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2z"/></svg>
          </div>
          <h3>المسابقات</h3>
          <p>مسابقات وتحديات مبتكرة تستهدف رواد الأعمال والمبدعين، مع جوائز قيمة وفرص حقيقية لتحويل الأفكار إلى مشاريع ناجحة.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        
        <!-- Platform 5: Events & Expo -->
        <div class="platform-card reveal reveal-delay-5">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>الفعاليات والمعارض</h3>
          <p>تنظيم وإدارة فعاليات ومعارض دولية ومحلية تجمع بين أصحاب القرار والمستثمرين ورواد الأعمال في بيئة محفزة.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
        
        <!-- Platform 6: Strategic Partnerships & B2B -->
        <div class="platform-card reveal reveal-delay-6">
          <div class="platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h3>الشراكات الاستراتيجية و B2B</h3>
          <p>بناء شراكات استراتيجية مع مؤسسات وشركات محلية ودولية، وتوفير حلول أعمال متكاملة لتعزيز النمو المشترك.</p>
          <a href="#" class="platform-link">
            اعرف المزيد
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       4. STATS / COUNTERS SECTION
       ========================================== -->
  <section class="stats-section" id="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card reveal reveal-delay-1">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="stat-number" data-counter="150" data-suffix="+">0</div>
          <div class="stat-label">شريك استراتيجي</div>
        </div>
        
