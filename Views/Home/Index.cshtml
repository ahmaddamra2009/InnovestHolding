            <select id="reg-interest" name="interest" class="form-control" required>
              <option value="" disabled selected>اختر مجال اهتمامك</option>
              <option value="التدريب والتعليم">التدريب والتعليم</option>
              <option value="الاستثمار والتمويل">الاستثمار والتمويل</option>
              <option value="التشبيك والشراكات">التشبيك والشراكات</option>
